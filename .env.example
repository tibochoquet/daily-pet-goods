# Kopieer dit bestand naar .env.local en vul de echte waarden in.
# .env.local staat in .gitignore en wordt nooit gecommit.

RESEND_API_KEY=re_YOUR_KEY_HERE

# Stripe Checkout (eenmalige bestellingen). Test-mode keys uit
# dashboard.stripe.com (staat op "Test mode" linksonder).
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY
# Krijg je van `stripe listen` (lokaal testen) of Stripe Dashboard ->
# Developers -> Webhooks (productie). Zie README voor de testflow.
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# Enige bron voor de site-origin - metadataBase, canonical URLs, sitemap,
# robots.txt, OG-afbeeldingen en de Stripe success_url/cancel_url lezen
# hier allemaal uit. Lokaal: http://localhost:3000. In Vercel productie:
# https://dailypetgoods.nl (apex, geen www).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Ads conversion tag (gtag.js). Alleen de basis-tag-ID, geen
# conversielabel - zie lib/gtag.ts voor het opbouwen van de "send_to" van
# een specifieke conversieactie (bv. een aankoop). Wordt alleen geladen in
# productie (zie app/layout.tsx), dus lokale dev-pageviews tellen nooit mee.
NEXT_PUBLIC_GTAG_ID=AW-XXXXXXXXXX

# Signs the /mijn-bestelling login and order-access cookies (HMAC, see
# lib/session.ts). Any long random string, e.g. `openssl rand -base64 32`.
# Changing it instantly logs everyone out, so treat it like any other secret.
SESSION_SECRET=

# Neon Postgres (Vercel Marketplace). Stripe blijft de bron voor de
# betaling zelf; deze database houdt alleen bij wat Stripe niet kan:
# of een mail al verstuurd is, de Sendcloud-zending, en de reviews.
# De unieke index op stripe_session_id is wat dubbele webhooks tegenhoudt.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Wachtwoord voor /admin/verzenden. Ontbreekt hij, dan gaat de
# beheerpagina dicht (500), nooit open. Maak een lange waarde:
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_PASSWORD=

# Beveiligt de dagelijkse cron. Vercel stuurt hem mee als
# Authorization: Bearer. Zelfde manier om er een te maken.
CRON_SECRET=
